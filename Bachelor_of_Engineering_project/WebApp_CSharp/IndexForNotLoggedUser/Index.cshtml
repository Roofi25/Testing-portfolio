@page
@model IndexForNotLoggedUserModel
@{
	ViewData["Title"] = "System wspomagania organizacji wydarzeń sportowych (w społeczności lokalnej)";
}

<style>
	.display-4 {
		text-align: center;
		padding: 10px;
		margin: 20px
	}

	.btn btn-primary btn-sm {
		text-align: center;
		padding: 10pc;
		margin: 10px
	}
</style>

<div class="text-center">
	@if (!string.IsNullOrEmpty(Model.successMessage))
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<strong>@Model.successMessage</strong>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	<br />
	<br />
	<br />
	<h1 class="display-4">Witamy w systemie wspomagającym organizację wydarzeń sportowych!</h1>
	<br />
	<div class="row mb-3">
		<div class="offset-sm-2 col-sm-3 d-grid">
			<a class="btn btn-primary btn-sm" href="/Registration">Zarejestruj się</a>
		</div>
		<div class="offset-sm-2 col-sm-3 d-grid">
			<a class="btn btn-primary btn-sm" href="/Login">Zaloguj się</a>
		</div>
	</div>
</div>