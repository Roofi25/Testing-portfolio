@page
@model System_wspomagajacy_organizacje_wydarzen_sportowych.Pages.YourEventsModel
@{
	ViewData["Title"] = "Twoje Wydarzenia Sportowe";
}

<html lang="pl">
	<head>
		<meta charset="uft-8"/>
		<style>
            .wewnetrzny {
                margin-top: 20px;
                padding-top: 10px;
                border-top: solid;
                display: flex;
                align-items: stretch;
				margin-bottom: 30px;
            }

            .wewnetrzny:nth-child(odd)
            {
                flex-direction: row;
            }

            .wewnetrzny:nth-child(even)
            {
                flex-direction: row-reverse;
            }

            .content
			{
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			h4 {
				text-align: center;
			}

			img{
				width: 40%;
				height: auto;
			}
			.text
			{
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 0 20px;
				margin-bottom: 0px;
			}
			.button-container
			{
				display: flex;
				justify-content: center;
				margin-top: 0px;
			}
			
			.btn{
				width: 250px;
				height: 50px;
				margin: 15px;
			}
			.helpingTheEvent
			{
				margin-top: 15px;
			}
		</style>
	</head>
	<body>
		@if (@Model.TempData["ErrorMessage"] != null)
		{
			<div class="alert alert-warning alert-dismissible fade show text-center" role="alert">
				<strong>@Model.TempData["ErrorMessage"]</strong>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		<h1>Wydarzenia sportowe, które ty organizujesz:</h1>
		@if(Model.TwojeWydarzeniaSportowe == null || Model.TwojeWydarzeniaSportowe.Count == 0)
		{
			<p>Nie zgłosiłeś/aś jeszcze organizacji żadnego wydarzenia sportowego!</p>
		}
		else
		{
			<div>
			@foreach (var wydarzenieSportowe in Model.TwojeWydarzeniaSportowe)
			{
				<div class="wewnetrzny">
					<img src="/images/logos/@wydarzenieSportowe.Logo" loading="lazy" alt="Logo Wydarzenia Sportowego">
					<div class="content">
						<div class="text">
							<h4>@wydarzenieSportowe.Nazwa</h4>
							<p>@wydarzenieSportowe.Ogloszenie</p>
						</div>
						<div class="button-container">
							<a class="btn btn-primary btn-lg" asp-page="/AddHelpers/Index" asp-route-id="@wydarzenieSportowe.IdWydarzenieSportowe">Przydziel pomocników</a>
							<a class="btn btn-primary btn-lg" asp-page="/EventInfo/Index" asp-route-id="@wydarzenieSportowe.IdWydarzenieSportowe">Sprawdź postępy</a>
						</div>
					</div>
				</div>
			}
			</div>
		}
		<h1 class="helpingTheEvent">Wydarzenia sportowe, które pomagasz zorganizować:</h1>
		@if(Model.WydarzeniaSportoweKtorePomagaszOrganizowac == null || Model.WydarzeniaSportoweKtorePomagaszOrganizowac.Count == 0)
		{
			<p>Nie zostałeś/aś jeszcze przydzielony/a do pomocy w organizacji żadnego wydarzenia sportowego!</p>
		}
		else
		{
			<div>
				@foreach (var wydarzenieSportowe in Model.WydarzeniaSportoweKtorePomagaszOrganizowac)
				{
					<div class="wewnetrzny">
						<img src="/images/logos/@wydarzenieSportowe.Logo" loading="lazy" alt="Logo Wydarzenia Sportowego">
						<div class="content">
							<div class="text">
								<h4>@wydarzenieSportowe.Nazwa</h4>
								<p>@wydarzenieSportowe.Ogloszenie</p>
							</div>
							<div class="button-container">
								<a asp-page="/HelpingTheEvent/Index" asp-route-id="@wydarzenieSportowe.IdWydarzenieSportowe">
									<button class="btn btn-primary btn-lg">Pomóż w organizacji</button>
								</a>
							</div>
						</div>
					</div>
				}
			</div>
		}
	</body>
</html>
