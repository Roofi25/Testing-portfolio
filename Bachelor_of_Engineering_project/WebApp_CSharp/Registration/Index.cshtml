@page
@model RegistrationModel
@{
	ViewData["Title"] = "Rejestracja";
}

<head>
	<meta charset="UTF-8">
	<style>
		body {
			text-align: center;
		}

		h2 {
			margin: 10px;
			padding: 10px;
		}

	</style>
</head>

<body>
	<br />
	<h1>Rejestracja</h1>

	@if (!string.IsNullOrEmpty(Model.errorMessage))
	{
		<div class="alert alert-warning alert-dismissible fade show" role="alert">
			<strong>@Model.errorMessage</strong>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<form method="POST">
		<br />
		<h2>Dane logowania:</h2>
		<div class="row mb-3">
			<label class="col-sm-2 offset-sm-2 col-form-label">Login:</label>
			<div class="col-sm-5">
				<input type="text" class="form-control" name="login">
			</div>
		</div>
		<div class="row mb-3">
			<label class="col-sm-2 offset-sm-2 col-form-label">Hasło:</label>
			<div class="col-sm-5">
				<input type="password" class="form-control" name="haslo">
			</div>
		</div>
		<div class="row mb-3">
			<label class="col-sm-2 offset-sm-2 col-form-label">Powtórz Hasło:</label>
			<div class="col-sm-5">
				<input type="password" class="form-control" name="powtorzHaslo">
			</div>
		</div>
		<br />
		<h2>Dane kontaktowe:</h2>
		<div class="row mb-3">
			<label class="col-sm-2 offset-sm-2 col-form-label">Imię:</label>
			<div class="col-sm-5">
				<input type="text" class="form-control" name="imie">
			</div>
		</div>
		<div class="row mb-3">
			<label class="col-sm-2 offset-sm-2 col-form-label">Nazwisko:</label>
			<div class="col-sm-5">
				<input type="text" class="form-control" name="nazwisko">
			</div>
		</div>
		<div class="row mb-3">
			<label class="col-sm-2 offset-sm-2 col-form-label">Adres email:</label>
			<div class="col-sm-5">
				<input type="text" class="form-control" name="email">
			</div>
		</div>
		<div class="row mb-3">
			<label class="col-sm-2 offset-sm-2 col-form-label">Data urodzenia:</label>
			<div class="col-sm-5">
				<input type="date" class="form-control" name="dataUrodzenia">
			</div>
		</div>
		<div class="row mb-3">
			<label class="col-sm-2 offset-sm-2 col-form-label">Numer telefonu:</label>
			<div class="col-sm-5">
				<input type="text" class="form-control" name="numerTelefonu">
			</div>
		</div>

		<div class="row mb-3">
			<div class="offset-sm-3 col-sm-3 d-grid">
				<a class="btn btn-outline-primary" href="/" role="button">Powrót</a>
			</div>
			<div class="col-sm-3 d-grid">
				<button type="submit" class="btn btn-primary">Potwierdź rejestracje</button>
			</div>
		</div>
	</form>
</body>