@page
@model System_wspomagajacy_organizacje_wydarzen_sportowych.Pages.AddTheEvent.IndexModel
@{
    ViewData["Title"] = "Dodaj Wydarzenie Sportowe";
}

<html lang="pl">
	<head>
		<meta charset="uft-8" />
		<style>
			body 
			{
				text-align: center;
			}
			.textarea-of-ogloszenie
			{
				resize: none;
				width: 100%;
			}
		</style>
	</head>
	<body>
		@if (@Model.TempData["ErrorMessage"] != null)
		{
			<div class="alert alert-warning alert-dismissible fade show text-center" role="alert">
				<strong>@Model.TempData["ErrorMessage"]</strong>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		@if (Model.TempData["SuccessMessage"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show text-center" role="alert">
				<strong>@Model.TempData["SuccessMessage"]</strong>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		<br />
		<h1>Zacznij tworzyć wydarzenie sportowe, które ty zorganizujesz!</h1>
		<form method="POST">
			<br />
			<div class="row mb-3">
				<label class="col-sm-2 offset-sm-2 col-form-label">Nazwa:</label>
				<div class="col-sm-5">
					<input type="text" class="form-control" asp-for="Nazwa">
					<span asp-validation-for="Nazwa" class="text-danger"></span>
				</div>
			</div>
			<div class="row mb-3">
				<label class="col-sm-2 offset-sm-2 col-form-label">Ogłoszenie:</label>
				<div class="col-sm-5">
					<textarea class="form-control textarea-of-ogloszenie" rows="10" asp-for="Ogloszenie"></textarea>
					<span asp-validation-for="Ogloszenie" class="text-danger"></span>
				</div>
			</div>
			<div class="row mb-3">
				<label class="col-sm-2 offset-sm-2 col-form-label">Liczba zawodów w wydarzeniu:</label>
				<div class="col-sm-5">
					<input type="number" class="form-control" asp-for="LiczbaZawodow"/>
					<span asp-validation-for="LiczbaZawodow" class="text-danger"></span>
				</div>
			</div>
			<div class="row mb-3">
				<div class="offset-sm-3 col-sm-3 d-grid">
					<a class="btn btn-outline-primary" href="/" role="button">Powrót</a>
				</div>
				<div class="col-sm-3 d-grid">
					<button type="submit" class="btn btn-primary">Przejdź dalej</button>
				</div>
			</div>
		</form>
	</body>
</html>
