@page
@using System_wspomagajacy_organizacje_wydarzen_sportowych.Models
@model AddHelpersModel
@{
    ViewData["Title"] = "Wydarzenie sportowe";
}

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<style>
			.wewnetrzny {
				margin-top: 20px;
				padding-top: 10px;
				border-top: solid;
				display: flex;
				align-items: stretch;
			}

			h4 
			{
				text-align: center;
			}

			.content {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			img {
				width: 40%;
				height: auto;
			}

			.text {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 0 20px;
				margin-bottom: 0px;
				align-items: center;
			}
			.button-container {
				display: flex;
				justify-content: center;
				margin-top: 0px;
			}
			.text-center
			{
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
			}
			select
			{
				margin: 7px;
			}
		</style>
	</head>
	<body>
		@if (@Model.TempData["ErrorMessage"] != null)
		{
			<div class="alert alert-warning alert-dismissible fade show text-center" role="alert">
				<strong>@Model.TempData["ErrorMessage"]</strong>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		@if (Model.TempData["SuccessMessage"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show text-center" role="alert">
				<strong>@Model.TempData["SuccessMessage"]</strong>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		@if (Model.WydarzenieSportowe.Ogloszenie == null)
		{
			<h1>Coś poszło nie tak!</h1>
		}
		<h1>@Model.WydarzenieSportowe.Nazwa</h1>
		<div>
			<div class="wewnetrzny">
				<img src="/images/logos/@Model.WydarzenieSportowe.Logo" loading="lazy" alt="Logo Wydarzenia Sportowego">
				<div class="content">
					<div class="text">
						@if (Model.WydarzenieSportowe == null || Model.DyscyplinyOrazDaty == null)
						{
							<p>Nie udało się wczytać danych danego wydarzenia!</p>
						}
						else
						{
							<h4>@Model.WydarzenieSportowe.Nazwa</h4>
							<p>@Model.WydarzenieSportowe.Ogloszenie</p>
							@foreach (var DyscyplinaOrazData in Model.DyscyplinyOrazDaty)
							{
								<p>@DyscyplinaOrazData.NazwaDyscypliny - @DyscyplinaOrazData.DataZawodow.ToString("dd.MM.yyyy") r.</p>
							}
							@if (HttpContext.Session.GetString("organisatorId") == "")
							{
								<p>Organizator: Brak</p>
							}
							else
							{
								if (Model.Organizator != null)
								{
									<p>Organizator: <a asp-page="/MorePersonInfo/Index" asp-route-id="@Model.Organizator.IdOsoba">@Model.Organizator.Imie @Model.Organizator.Nazwisko</a></p>
								}
								else
								{
									<p>Coś poszło nie tak podczas ustalania organizatora wydarzenia!</p>
								}
							}
						}
					</div>
				</div>
			</div>
			<div class="form">
				<form method="post">
					<input type="hidden" name="EventId" value="@HttpContext.Session.GetString("id")" />
					<div class="row mb-3">
						<label class="col-sm-5 col-form-label">Funkcja zarządzanie obiektami sportowymi:</label>
						<select asp-for="WybranaOsobaDoObiektowSportowych" asp-items='@(ViewData["possibleHelpersList"] as SelectList)' class="input-group"></select>
						@if (Model.PomocnikDoObiektowSportowych == null)
						{
							<p>Aktualny pomocnik: Brak</p>
						}
						else
						{
							<p>Aktualny pomocnik: @Model.PomocnikDoObiektowSportowych.Imie @Model.PomocnikDoObiektowSportowych.Nazwisko</p>
						}
					</div>
					<div class="row mb-3">
						<label class="col-sm-5 col-form-label">Funkcja zarządzanie lokalami gastronomicznymi:</label>
						<select asp-for="WybranaOsobaDoLokaliGastronomicznych" asp-items='@(ViewData["possibleHelpersList"] as SelectList)' class="input-group"></select>
						@if (Model.PomocnikDoLokaliGastronomicznych == null)
						{
							<p>Aktualny pomocnik: Brak</p>
						}
						else
						{
							<p>Aktualny pomocnik: @Model.PomocnikDoLokaliGastronomicznych.Imie @Model.PomocnikDoLokaliGastronomicznych.Nazwisko</p>
						}
					</div>
					<div class="row mb-3">
						<label class="col-sm-5 col-form-label">Funkcja zarządzanie sponsorami:</label>
						<select asp-for="WybranaOsobaDoSposnorow" asp-items='@(ViewData["possibleHelpersList"] as SelectList)' class="input-group"></select>
						@if (Model.PomocnikDoSponsorow == null)
						{
							<p>Aktualny pomocnik: Brak</p>
						}
						else
						{
							<p>Aktualny pomocnik: @Model.PomocnikDoSponsorow.Imie @Model.PomocnikDoSponsorow.Nazwisko</p>
						}
					</div>
					<div class="row mb-3">
						<label class="col-sm-5 col-form-label">Funkcja zarządzanie zawodnikami:</label>
						<select asp-for="WybranaOsobaDoZawodnikow" asp-items='@(ViewData["possibleHelpersList"] as SelectList)' class="input-group"></select>
						@if (Model.PomocnikDoZawodnikow == null)
						{
							<p>Aktualny pomocnik: Brak</p>
						}
						else
						{
						<p>Aktualny pomocnik: @Model.PomocnikDoZawodnikow.Imie @Model.PomocnikDoZawodnikow.Nazwisko</p>
						}
					</div>
					<div class="row mb-3">
						<div class="offset-sm-3 col-sm-3 d-grid">
							<a class="btn btn-outline-primary" href="/YourEvents/Index" role="button">Powrót</a>
						</div>
						<div class="col-sm-3 d-grid">
							<button type="submit" class="btn btn-primary">Przypisz pomocników</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</body>
</html>
