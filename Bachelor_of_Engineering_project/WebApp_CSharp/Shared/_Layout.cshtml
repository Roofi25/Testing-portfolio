@using Microsoft.AspNetCore.Http;
@using System.Text.Json
@using System_wspomagajacy_organizacje_wydarzen_sportowych.Models.BazaDanych
@{
    var isLoggedIn = Context.Session.GetString("IsLoggedIn");
    Osoba? loggedUser = null;
    if(isLoggedIn == "true")
    {
        //pobieramy jsona z sesji
        string? json = Context.Session.GetString("LoggedUser");
        //deserializujemy jsona do obiektu o nazwie loggedUser, ktory bedzie zawierał informacje o aktualnie zalogowanym użytkowniku
        loggedUser = JsonSerializer.Deserialize<Osoba>(json);
    }
    bool IsAdmin(int idOsoba)
    {
        return idOsoba == 1;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>System wspomagający organizację wydarzeń sportowych</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/System_wspomagajacy_organizacje_wydarzen_sportowych.styles.css" asp-append-version="true" />

    <style>
        .system-name {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            text-align: center;
            padding: 10px 0;
        }

        .navbar-nav {
            text-align: center;
            width: 100%;
        }

            .navbar-nav .nav-item {
                display: inline-block;
            }
    </style>
</head>
<body>
    @if (isLoggedIn == "true")
    {
        <header class="sticky-top">
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">S.W.O.W.S</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/AllEvents/Index">Wszystkie wydarzenia</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/YourEvents/Index">Twoje wydarzenia</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Archive/Index">Archiwum</a>
                            </li>
                            <div class="ms-auto d-flex align-items-center">
                                @if (IsAdmin(loggedUser.IdOsoba))
                                {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/AdministratorPanel/Index">Panel administratora</a>
                                </li>
                                }
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Logout/Index">Wyloguj się</a>
                                </li>
                            </div>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    else
    {
        <header class="sticky-top">
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">System wspomagający organizację wydarzeń sportowych</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; Rafał Wronowski - System wspomagający organizację wydarzeń sportowych - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>