@page
@model System_wspomagajacy_organizacje_wydarzen_sportowych.Pages.HelpingTheEvent.IndexModel
@{
    ViewData["Title"] = "Wydarzenie Sportowe";
}

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<style>
			.wewnetrzny {
				margin-top: 20px;
				padding-top: 10px;
				border-top: solid;
				display: flex;
				align-items: stretch;
			}

			.content {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			img {
				width: 40%;
				height: auto;
			}

			.text {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 0 20px;
				margin-bottom: 0px;
				align-items: center;
			}

			h4 {
				text-align: center;
			}

			.button-container {
				display: flex;
				justify-content: center;
				margin-top: 0px;
			}

			.text-center {
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
			}

			select {
				margin: 7px;
			}

			.roleInfo
			{
				margin-top: 20px;
			}

			h2{
				margin-top: 10px;
				margin-bottom: 10px;
			}

			#buttons
			{
				margin-left: 32px;
			}

			.modifyPlayer
			{
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				justify-content: center;
				height: 100%;
			}

			.editPlayer, .deletePlayer
			{
				margin-bottom: 10px;
				display: block;
			}

			.formularz
			{
				margin-top: 25px;
			}

			.role
			{
				text-align: left;
			}
		</style>
	</head>
	<body>
		@if (@Model.TempData["ErrorMessage"] != null)
		{
			<div class="alert alert-warning alert-dismissible fade show text-center" role="alert">
				<strong>@Model.TempData["ErrorMessage"]</strong>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		@if (Model.TempData["SuccessMessage"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show text-center" role="alert">
				<strong>@Model.TempData["SuccessMessage"]</strong>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		@if (Model.WydarzenieSportowe.Ogloszenie == null)
		{
			<h1>Coś poszło nie tak!</h1>
		}
		<h1>@Model.WydarzenieSportowe.Nazwa</h1>
		<div>
			<div class="wewnetrzny">
				<img src="/images/logos/@Model.WydarzenieSportowe.Logo" loading="lazy" alt="Logo Wydarzenia Sportowego">
				<div class="content">
					<div class="text">
						@if (Model.WydarzenieSportowe == null || Model.DyscyplinyOrazDaty == null)
						{
							<p>Nie udało się wczytać danych danego wydarzenia!</p>
						}
						else
						{
							<h4>@Model.WydarzenieSportowe.Nazwa</h4>
							<p>@Model.WydarzenieSportowe.Ogloszenie</p>
							@foreach (var DyscyplinaOrazData in Model.DyscyplinyOrazDaty)
							{
								<p>@DyscyplinaOrazData.NazwaDyscypliny - @DyscyplinaOrazData.DataZawodow.ToString("dd.MM.yyyy") r.</p>
							}
							@if (HttpContext.Session.GetString("organisatorId") == "")
							{
								<p>Organizator: Brak</p>
							}
							else
							{
								if (Model.Organizator != null)
								{
									<p>Organizator: <a asp-page="/MorePersonInfo/Index" asp-route-id="@Model.Organizator.IdOsoba">@Model.Organizator.Imie @Model.Organizator.Nazwisko</a></p>
								}
								else
								{
									<p>Coś poszło nie tak podczas ustalania organizatora wydarzenia!</p>
								}
							}
						}
					</div>
				</div>
			</div>
			@foreach(var funkcja in Model.Funkcje)
			{
				<div class="roleInfo">
					<h4 class="role">Twoja rola to: @funkcja.Nazwa</h4>
					<p>@funkcja.Opis</p>
				</div>
				<div class="form">
					<form method="post">
						@switch(funkcja.IdFunkcja)
						{
							case 1:
								<div class="formularz">
									<input type="hidden" name="EventId" value="@HttpContext.Session.GetString("eventId")" />
									@for(int i = 0; i < Model.IloscDyscyplin; i++)
									{
										<div class="row mb-3">
											<label class="col-sm-5 col-form-label">Dyscyplina: @Model.DyscyplinyOrazDaty.ElementAt(i).NazwaDyscypliny </label>
											<select name="WybraneObiektySportowe[@i]" asp-items='@(ViewData["possibleSportFacilityList"] as SelectList)' class="input-group"></select>
											@if(Model.AktualneObiektySportowe.ElementAt(i) == null)
											{
												<p>Aktualny obiekt sportowy: Brak</p>
											}
											else
											{
												<p>Aktualny obiekt sportowy: @Model.AktualneObiektySportowe.ElementAt(i).Nazwa</p>
											}
										</div>
									}
									<div class="row mb-3">
										<div class="col-sm-3">
											<a class="btn btn-primary" asp-page="/AddSportFacility/Index" asp-route-id="@Model.WydarzenieSportowe.IdWydarzenieSportowe" role="button">Dodaj obiekt sportowy</a>
										</div>
									</div>
									<div class="row mb-3">
										<div class="offset-sm-3 col-sm-3 d-grid">
											<a class="btn btn-outline-primary" href="/YourEvents/Index" role="button">Powrót</a>
										</div>
										<div class="col-sm-3 d-grid">
											<button type="submit" class="btn btn-primary">Przypisz obiekty sportowe</button>
										</div>
									</div>
								</div>
								break;
							case 2:
								<div class="formularz">
									<input type="hidden" name="EventId" value="@HttpContext.Session.GetString("eventId")" />
									@for (int i = 0; i < Model.IloscDyscyplin; i++)
									{
										<div class="row mb-3">
											<label class="col-sm-5 col-form-label">Dyscyplina: @Model.DyscyplinyOrazDaty.ElementAt(i).NazwaDyscypliny</label>
											<select name="WybraneLokaleGastronomiczne[@i]" asp-items='@(ViewData["possibleTreatFacilityList"] as SelectList)' class="input-group"></select>
											@if(Model.AktualneLokaleGastronomiczne.ElementAt(i) == null)
											{
												<p>Aktualny obiekt gastronomiczny: Brak</p>
											}
											else
											{
												<p>Aktualny obiekt gastronomiczny: @Model.AktualneLokaleGastronomiczne.ElementAt(i).Nazwa</p>
											}
									</div>
									}
									<div class="row mb-3">
										<div class="col-sm-3">
											<a class="btn btn-primary" asp-page="/AddTreatFacility/Index" asp-route-id="@Model.WydarzenieSportowe.IdWydarzenieSportowe" role="button">Dodaj lokal gastronomiczny</a>
										</div>
									</div>
									<div class="row mb-3">
										<div class="offset-sm-3 col-sm-3 d-grid">
											<a class="btn btn-outline-primary" href="/YourEvents/Index" role="button">Powrót</a>
										</div>
										<div class="col-sm-3 d-grid">
											<button type="submit" class="btn btn-primary">Przypisz lokale gastronomiczne</button>
										</div>
									</div>
								</div>
								break;
							case 3:
								<div class="formularz">
									<input type="hidden" name="EventId" value="@HttpContext.Session.GetString("eventId")" />
									@for (int i = 0; i < Model.IloscDyscyplin; i++)
									{
										<div class="row mb-3">
											<label class="col-sm-5 col-form-label">Dyscyplina: @Model.DyscyplinyOrazDaty.ElementAt(i).NazwaDyscypliny</label>
											<select name="WybraniSponsorzy[@i]" asp-items='@(ViewData["possibleSponsorList"] as SelectList)' class="input-group"></select>
											@if(Model.AktualniSponsorzy.ElementAt(i) == null)
											{
												<p>Aktualny sponsor: Brak</p>
											}
											else
											{
												<p>Aktualny sponsor: @Model.AktualniSponsorzy.ElementAt(i).Nazwa</p>
											}
									</div>
									}
									<div class="row mb-3">
										<div class="col-sm-3">
											<a class="btn btn-primary" asp-page="/AddSponsor/Index" asp-route-id="@Model.WydarzenieSportowe.IdWydarzenieSportowe" role="button">Dodaj sponsora</a>
										</div>
									</div>
									<div class="row mb-3">
										<div class="offset-sm-3 col-sm-3 d-grid">
											<a class="btn btn-outline-primary" href="/YourEvents/Index" role="button">Powrót</a>
										</div>
										<div class="col-sm-3 d-grid">
											<button type="submit" class="btn btn-primary">Przypisz sponsorów</button>
										</div>
									</div>
								</div>
								break;
							case 4:
								<div class="formularz">
									<h2>Dane Zawodnika:</h2>
									<div class="row mb-3">
										<label class="col-sm-2 col-form-label">Imię:</label>
										<div class="col-sm-5">
											<input type="text" class="form-control" name="imie">
										</div>
									</div>
									<div class="row mb-3">
										<label class="col-sm-2 col-form-label">Nazwisko:</label>
										<div class="col-sm-5">
											<input type="text" class="form-control" name="nazwisko">
										</div>
									</div>
									<div class="row mb-3">
										<label class="col-sm-2 col-form-label">Adres email:</label>
										<div class="col-sm-5">
											<input type="text" class="form-control" name="email">
										</div>
									</div>
									<div class="row mb-3">
										<label class="col-sm-2 col-form-label">Data urodzenia:</label>
										<div class="col-sm-5">
											<input type="date" class="form-control" name="dataUrodzenia">
										</div>
									</div>
									<div class="row mb-3">
										<label class="col-sm-2 col-form-label">Numer telefonu:</label>
										<div class="col-sm-5">
											<input type="text" class="form-control" name="numerTelefonu">
										</div>
									</div>
									@for(int i = 0; i < Model.IloscDyscyplin; i++)
									{
										var checkboxId = "checkboxId_" + i;
										<div class="row mb-3">
										<label class="col-sm-6" for="@checkboxId">@Model.DyscyplinyOrazDaty.ElementAt(i).NazwaDyscypliny - @Model.DyscyplinyOrazDaty.ElementAt(i).DataZawodow.ToString("dd.MM.yyyy")r.</label>
											<div class="col-sm-2">
												<input type="checkbox" id="@checkboxId" class="form-check-input" name="WybraneZawody" value="@Model.Zawody.ElementAt(i).IdZawody" />
											</div>
										</div>
									}
									<div class="row mb-3">
										<div class="col-sm-3 d-grid">
											<a class="btn btn-outline-primary" href="/YourEvents" role="button">Powrót</a>
										</div>
										<div class="col-sm-3 d-grid">
											<button type="submit" class="btn btn-primary">Dodaj zawodnika</button>
										</div>
									</div>
									<div class="row mb-3 modifyPlayer">
										<div class="editPlayer">
											<a class="btn btn-primary" asp-page="/EditPlayers/Index" role="button" asp-route-id="@Model.WydarzenieSportowe.IdWydarzenieSportowe">Edytuj zawodników</a>
										</div>
										<div class="deletePlayer">
											<a class="btn btn-primary" asp-page="/DeletePlayers/Index" role="button" asp-route-id="@Model.WydarzenieSportowe.IdWydarzenieSportowe">Usuń zawodników</a>
										</div>
									</div>
								</div>
								break;
							default:
								<p>Coś poszło nie tak!</p>
								break;
						}
					</form>
				</div>
			}
		</div>
	</body>
</html>
