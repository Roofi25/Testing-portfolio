    {
      "name": "Create board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//three things to test:\r",
              "//1 - status code\r",
              "//2 - response time\r",
              "//3 - body of the response (data in json)\r",
              "\r",
              "//Creating a collection variable that will contain the id of the \r",
              "//created board (used in Delete board)\r",
              "let responseData = pm.response.json();\r",
              "pm.collectionVariables.set(\"boardId\", responseData.id);;\r",
              "pm.collectionVariables.set(\"organizationId\", responseData.idOrganization);\r",
              "\r",
              "//Status code\r",
              "pm.test(\"Create board -> Correct Status Code(200)\", function(){\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "//We can retrieve query parameter \"name\". By doing this \r",
              "//the DRY principle is respected and if we are gonna change \r",
              "//the value of this query parameter we will not need to \r",
              "//change all of the test cases. We need to decodeURIComponent\r",
              "//in case when the name has spaces in it. Without it the \r",
              "//test case will fail because the name parameter would have \r",
              "//value \"example%20name\" instead of \"example name\".\r",
              "let queryParams = pm.request.url.query.toObject();\r",
              "let expectedBoardName = decodeURIComponent(queryParams[\"name\"]);\r",
              "\r",
              "//Name in response body\r",
              "pm.test(\"Create board -> Board name is correct\", function(){\r",
              "    pm.expect(responseData.name).to.eql(expectedBoardName);\r",
              "});\r",
              "\r",
              "pm.test(\"Create board -> Content-type is application json\", function()\r",
              "{\r",
              "    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\")\r",
              "});\r",
              "\r",
              "pm.test(\"Create board -> Response has parameter id\", function()\r",
              "{\r",
              "    pm.expect(responseData).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "pm.test(\"Create board -> Board is not closed by a default\", function()\r",
              "{\r",
              "    pm.expect(responseData.closed).to.eql(false);\r",
              "});\r",
              "\r",
              "pm.test(\"Create board -> Board's parameter 'permissionLevel' is set to private by default\", function()\r",
              "{\r",
              "    pm.expect(responseData.prefs.permissionLevel).to.eql(\"private\")\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
